{
  "name": "pba-hub",
  "version": "1.0.0",
  "private": true,
  "description": "PBA (Professional Billiards Association) — stats, teams, live match centre and schedule, powered by the pbatour.org data API.",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "tsc --noEmit",
    "test": "npm run test:parsers && npm run test:match",
    "test:parsers": "node --experimental-strip-types scripts/test-parsers.mjs",
    "test:match": "node --experimental-strip-types scripts/test-match.mjs",
    "verify": "node scripts/verify-interactions.mjs",
    "refresh-data": "node scripts/refresh-data.mjs && node --experimental-strip-types scripts/build-calendar.mjs",
    "build-calendar": "node --experimental-strip-types scripts/build-calendar.mjs"
  },
  "dependencies": {
    "next": "15.5.28",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.18.13",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
