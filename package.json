{
  "name": "pba-hub",
  "version": "1.0.0",
  "private": true,
  "description": "PBA (Professional Billiards Association) — stats, teams, live match centre and schedule, powered by the pbatour.org data API.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "tsc --noEmit -p tsconfig.lint.json",
    "test": "npm run test:parsers && npm run test:match && npm run test:security",
    "test:parsers": "node --experimental-strip-types scripts/test-parsers.mjs",
    "test:match": "node --experimental-strip-types scripts/test-match.mjs",
    "test:security": "node --experimental-strip-types scripts/test-security.mjs",
    "verify": "node scripts/verify-interactions.mjs",
    "refresh-data": "node scripts/refresh-data.mjs && node --experimental-strip-types scripts/build-calendar.mjs",
    "build-calendar": "node --experimental-strip-types scripts/build-calendar.mjs"
  },
  "dependencies": {
    "flag-icons": "^7.6.0",
    "next": "^15.5.29",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "sanitize-html": "^2.18.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.18.13",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@types/sanitize-html": "^2.16.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "^8.5.33"
  }
}
